        <locationX>880</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Show_Industry_Confirmation_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Industry Missing</defaultConnectorLabel>
        <rules>
            <name>Industry_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordData.Industry</leftValueReference>
                <operator>IsNull</operator>
            </conditions>
            <connector>
                <targetReference>Show_Final_Confirmation_Screen</targetReference>
            </connector>
            <label>Industry Assigned</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_Confirms_Update</name>
        <label>User Confirms Update</label>
        <locationX>1232</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Flow_Cancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>User Cancelled</defaultConnectorLabel>
        <rules>
            <name>User_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FinalConfirmation</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proceed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Record</targetReference>
            </connector>
            <label>User Approved</label>
        </rules>
    </decisions>
    <formulas>
        <name>IsValidAccountNumberFormat</name>
        <dataType>Boolean</dataType>
        <expression>
            AND(
                LEN(recordData.AccountNumber) = 10,
                ISNUMBER(VALUE(LEFT(recordData.AccountNumber, 4))),
                CONTAINS("ABCDEFGHIJKLMNOPQRSTUVWXYZ", MID(recordData.AccountNumber, 5, 1)),
                ISNUMBER(VALUE(RIGHT(recordData.AccountNumber, 5)))
            )
        </expression>
    </formulas>
    <formulas>
        <name>DuplicateAccountCount</name>
        <dataType>Number</dataType>
        <expression>
            COUNT(
                SELECT Account FROM Account WHERE AccountNumber = recordData.AccountNumber AND Id != recordData.Id
            )
        </expression>
    </formulas>
    <formulas>
        <name>GeneratedAccountNumber</name>
        <dataType>String</dataType>
        <expression>
            CONCATENATE(
                TEXT(YEAR(NOW())),
                TEXT(MONTH(NOW())),
                LEFT(recordData.Name, 2),
                TEXT(RANDBETWEEN(1000, 9999))
            )
        </expression>
    </formulas>
    <formulas>
        <name>AuditTrailMessage</name>
        <dataType>String</dataType>
        <expression>
            CONCATENATE(
                "Account Number Updated: ",
                recordData.AccountNumber,
                " | Status Changed to: Customer | Updated By: ",
                $User.FirstName,
                " ",
                $User.LastName,
                " | Timestamp: ",
                TEXT(NOW())
            )
        </expression>
    </formulas>
