<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Check_Account_Status_Change</name>
        <label>Check Account Status Change</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Status_Not_Customer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_Is_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordData.AccountStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Number_Exists</targetReference>
            </connector>
            <label>Status Is Customer</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Account_Number_Exists</name>
        <label>Check Account Number Exists</label>
        <locationX>352</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Generate_Account_Number</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account Number Missing</defaultConnectorLabel>
        <rules>
            <name>Account_Number_Already_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordData.AccountNumber</leftValueReference>
                <operator>IsNull</operator>
            </conditions>
            <connector>
                <targetReference>Validate_Account_Number_Format</targetReference>
            </connector>
            <label>Account Number Already Assigned</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validate_Account_Number_Format</name>
        <label>Validate Account Number Format</label>
        <locationX>528</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Show_Invalid_Format_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Format</defaultConnectorLabel>
        <rules>
            <name>Format_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsValidAccountNumberFormat</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Duplication</targetReference>
            </connector>
            <label>Format Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Account_Duplication</name>
        <label>Check Account Duplication</label>
        <locationX>704</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Show_Duplicate_Account_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Duplicate Found</defaultConnectorLabel>
        <rules>
            <name>No_Duplicates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>DuplicateAccountCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Account_Industry</targetReference>
            </connector>
            <label>No Duplicates</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Account_Industry</name>
